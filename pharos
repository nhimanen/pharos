def _resolve_index_dir() -> Path:
    """Read indexDir from ~/.pharos/config.json, falling back to the default."""
    config_file = PHAROS_DIR / "config.json"
    index_dir = PHAROS_DIR / "indexes"
    if config_file.exists():
        try:
            cfg = json.loads(config_file.read_text())
            if cfg.get("indexDir"):
                index_dir = Path(cfg["indexDir"])
        except Exception:
            pass
    return index_dir


def _valid_project_name(index_dir: Path, name) -> bool:
    """Mirror of com.pharos.indexer.ProjectNames: the name must map to a strict direct child dir."""
    if not name or not str(name).strip() or name in (".", ".."):
        return False
    if "/" in name or "\\" in name:
        return False
    return (index_dir / name).resolve().parent == index_dir.resolve()


def _invalidate_project_embeddings(index_dir: Path, project: str, scope: str) -> int:
    """Set chunkingVersion=0 for files matching scope in a single project's file-state.json.

    Returns the number of entries changed, or -1 if the state file is missing.
    """
    state_file = index_dir / project / "file-state.json"
    if not state_file.exists():
        return -1

    DOC_EXTS  = {".md", ".txt", ".yml", ".yaml", ".sh", ".xml"}
    JAVA_EXTS = {".java"}
    GO_EXTS   = {".go"}

    def is_target(path: str) -> bool:
        ext = Path(path).suffix.lower()
        if scope == "docs": return ext in DOC_EXTS
        if scope == "java": return ext in JAVA_EXTS
        if scope == "go":   return ext in GO_EXTS
        return True

    state = json.loads(state_file.read_text())
    changed = 0
    for path, entry in state.items():
        if is_target(path):
            entry["chunkingVersion"] = 0
            changed += 1

    tmp = state_file.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state))
    tmp.replace(state_file)
    return changed


def cmd_invalidate_embeddings(args):
    """Mark file embeddings as stale so the next incremental index re-embeds them."""
    if args.all and args.project:
        die("Specify either a project name or --all, not both.")
    if not args.all and not args.project:
        die("Missing project name. Pass a project name or use --all.")

    index_dir = _resolve_index_dir()
    scope_label = {"docs": "document", "java": "Java", "all": "all"}[args.scope]

    if args.all:
        registry_file = PHAROS_DIR / "registry.json"
        if not registry_file.exists():
            die("No registry found — have you indexed any projects yet?")
        projects = list(json.loads(registry_file.read_text()).keys())
        if not projects:
            print("No indexed projects found.")
            return
        total = 0
        for project in projects:
            if not _valid_project_name(index_dir, project):
                print(f"  '{project}': invalid project name, skipped (see UPGRADING.md)")
                continue
            n = _invalidate_project_embeddings(index_dir, project, args.scope)
            if n < 0:
                print(f"  {project}: no file-state.json, skipped")
            else:
                print(f"  {project}: {n} {scope_label} file(s) invalidated")
                total += n
        print(f"\nDone: {total} {scope_label} file(s) invalidated across {len(projects)} project(s).")
    else:
        if not _valid_project_name(index_dir, args.project):
            die(f"Invalid project name '{args.project}': it must be a plain directory name directly "
                f"under {index_dir}.")
        n = _invalidate_project_embeddings(index_dir, args.project, args.scope)
        if n < 0:
            die(f"No file-state.json found for project '{args.project}' at "
                f"{index_dir / args.project / 'file-state.json'}\nHas this project been indexed?")
        print(f"Invalidated embeddings for {n} {scope_label} file(s) in '{args.project}'.")

    print("Run './pharos index <path>' to re-embed only those files.")


DAEMON_STOP_TIMEOUT_S = 20   # the daemon finishes running model calls (≤ 15 s) before exiting


def _terminate_daemon(pid):
    """SIGTERM the daemon and wait until the process is gone.

    The daemon finishes in-flight model calls before exiting (otherwise ONNX Runtime can
    crash on shutdown), which takes several seconds when it is embedding. Returning early let
    `restart` start a second JVM that lost the port race and exited, leaving no daemon.
    Falls back to SIGKILL — which runs no shutdown hooks, so it is crash-safe — after the timeout.
    Returns False if the process was not running.
    """
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        return False
    deadline = time.monotonic() + DAEMON_STOP_TIMEOUT_S
    while time.monotonic() < deadline:
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return True
        time.sleep(0.2)
    print(f"pharos daemon (pid={pid}) did not exit within {DAEMON_STOP_TIMEOUT_S}s; killing it.",
          file=sys.stderr)
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    return True


def cmd_daemon(args):
    """Manage the background daemon."""
    action = args.action
    if action == "status":
        if _is_daemon_running():
            pid = DAEMON_PID_FILE.read_text().strip() if DAEMON_PID_FILE.exists() else "?"
            print(f"pharos daemon is running (pid={pid}, port={DAEMON_PORT})")
        else:
            print("pharos daemon is not running.")
    elif action == "start":
        if _is_daemon_running():
            print(f"pharos daemon is already running on port {DAEMON_PORT}.")
        else:
            print("Starting pharos daemon...", flush=True)
            _start_daemon()
            print(f"pharos daemon started on port {DAEMON_PORT}.")
    elif action == "stop":
        if DAEMON_PID_FILE.exists():
            try:
                pid = int(DAEMON_PID_FILE.read_text().strip())
                if not _terminate_daemon(pid):
                    raise ProcessLookupError
                DAEMON_PID_FILE.unlink(missing_ok=True)
                print(f"pharos daemon (pid={pid}) stopped.")
            except (ProcessLookupError, ValueError):
                DAEMON_PID_FILE.unlink(missing_ok=True)
                print("pharos daemon was not running.")
        else:
            print("pharos daemon is not running.")
    elif action == "restart":
        if DAEMON_PID_FILE.exists():
            try:
                pid = int(DAEMON_PID_FILE.read_text().strip())
                _terminate_daemon(pid)
            except ValueError:
                pass
            DAEMON_PID_FILE.unlink(missing_ok=True)
        print("Starting pharos daemon...", flush=True)
        _start_daemon()
        print(f"pharos daemon started on port {DAEMON_PORT}.")
    elif action == "logs":
        if DAEMON_LOG_FILE.exists():
            lines = DAEMON_LOG_FILE.read_text().splitlines()
            print("\n".join(lines[-50:]))
        else:
            print("No daemon log found.")


