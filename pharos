#!/usr/bin/env python3
"""
pharos - Python CLI client for the Pharos code search tool.

Uses a persistent background daemon (pharos web server) to avoid JVM cold-start
on every command. The daemon is started automatically on first use and reused
for subsequent calls.

Install:
  cp pharos ~/.local/bin/pharos && chmod +x ~/.local/bin/pharos

JAR resolution order:
  1. <script-dir>/target/pharos-*.jar   (development / repo checkout)
  2. ~/.pharos/bin/pharos.jar            (installed)

Daemon port: 7171  (override with PHAROS_PORT env var)

Env vars honored on every JVM launch:
  PHAROS_HEAP   pass -Xmx<value> (e.g. PHAROS_HEAP=16g pharos index ...)
"""

import argparse
import glob
import json
import os
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

# ── JAR resolution ────────────────────────────────────────────────────────────

def _resolve_jar() -> Path:
    """Find the pharos JAR: prefer local target/ build, fall back to installed."""
    script_dir = Path(__file__).resolve().parent
    candidates = sorted(glob.glob(str(script_dir / "target" / "pharos-*.jar")), reverse=True)
    if candidates:
        return Path(candidates[0])
    return Path.home() / ".pharos" / "bin" / "pharos.jar"

JAR = _resolve_jar()
PHAROS_DIR = Path.home() / ".pharos"
PHAROS_DUMPS = PHAROS_DIR / "dumps"
DAEMON_PORT = int(os.environ.get("PHAROS_PORT", "7171"))
DAEMON_PID_FILE = PHAROS_DIR / "daemon.pid"
DAEMON_LOG_FILE = PHAROS_DIR / "daemon.log"
BASE_URL = f"http://localhost:{DAEMON_PORT}"


# ── Shared JVM flags ─────────────────────────────────────────────────────────

def _default_heap() -> str:
    """Returns a heap size string (e.g. '6g') based on available RAM.

    Target: 75 % of physical RAM, clamped to [2g, 24g].
    This overrides the JVM's default heuristic (~25% of RAM) which is too
    conservative for indexing large projects (ParsedProject bodies + ONNX model
    + ArcadeDB page cache can easily consume 4–8 GB for projects like lucene).
    Override with PHAROS_HEAP=Ng to use a specific value.
    """
    try:
        total_bytes = os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE")
        target_gb = max(2, min(24, int(total_bytes * 0.75 / (1024 ** 3))))
        return f"{target_gb}g"
    except Exception:
        return "4g"  # safe fallback when sysconf is unavailable


def _jvm_flags() -> list:
    """Common JVM args for every pharos subprocess: native-access opens for
    Lucene/ArcadeDB, vector incubator module for SIMD-accelerated KNN, and
    HeapDumpOnOutOfMemoryError so a post-mortem .hprof lands in ~/.pharos/dumps/.

    Heap: defaults to 75 % of RAM (clamped 2–24 g) so large projects (lucene,
    solr, vespa) can be indexed without OOM. Override with PHAROS_HEAP=Ng.
    """
    PHAROS_DUMPS.mkdir(parents=True, exist_ok=True)
    heap = os.environ.get("PHAROS_HEAP", "").strip() or _default_heap()
    flags = [
        f"-Xmx{heap}",
        "--enable-native-access=ALL-UNNAMED",
        "--add-opens", "java.base/java.nio.channels.spi=ALL-UNNAMED",
        "--add-modules", "jdk.incubator.vector",
        "-XX:+HeapDumpOnOutOfMemoryError",
        f"-XX:HeapDumpPath={PHAROS_DUMPS}",
        # The JVM resolves user.home from the passwd entry, not $HOME: pin the pharos dir to
        # the one this client uses, so both always read the same registry and indexes.
        f"-Dpharos.home={PHAROS_DIR}",
        # Suppress ArcadeDB/GraalVM Truffle warning about missing JVMCI (not needed
        # for pharos — ArcadeDB queries are I/O-bound, not CPU-bound).
        "-Dpolyglot.engine.WarnInterpreterOnly=false",
    ]
    return flags

# ── Daemon management ─────────────────────────────────────────────────────────

def _health_status():
    """HTTP status of the daemon's /health (200 ready or degraded, 503 warming or draining), or None when nothing answers."""
    try:
        with urllib.request.urlopen(f"{BASE_URL}/health", timeout=1) as resp:
            return resp.status
    except urllib.error.HTTPError as e:
        return e.code
    except Exception:
        return None


def _is_daemon_running() -> bool:
    """Return True if the daemon is responding on its health endpoint (ready or still warming:
    a reader answers 503 until its first sync and its search models are done)."""
    return _health_status() in (200, 503)


def _daemon_ready() -> bool:
    """True once the daemon reports ready (HTTP 200)."""
    return _health_status() == 200


DAEMON_LOG_MAX_BYTES = 20 * 1024 * 1024   # rotate at daemon start once the log exceeds this
DAEMON_LOG_KEEP = 2                        # daemon.log.1 … daemon.log.N are kept


def _read_daemon_pid():
    """PID recorded in daemon.pid, or None."""
    try:
        return int(DAEMON_PID_FILE.read_text().strip())
    except (OSError, ValueError):
        return None


def _pid_alive(pid):
    """True if a process with this PID exists (signal 0 probes without sending anything)."""
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True   # exists, owned by someone else
    except OSError:
        return False


def _rotate_daemon_log():
    """Rotate daemon.log when it has grown past DAEMON_LOG_MAX_BYTES.

    The daemon appends to one file across restarts and nothing ever trimmed it (one install
    reached 246 MB). Rotation happens only here, before a new daemon opens the file, and is
    skipped while the PID in daemon.pid is still alive — so a running daemon (even one too
    slow to answer the /health probe) never has its log moved underneath it.
    """
    try:
        if not DAEMON_LOG_FILE.exists() or DAEMON_LOG_FILE.stat().st_size <= DAEMON_LOG_MAX_BYTES:
            return
        if _pid_alive(_read_daemon_pid()):
            # A daemon is still alive (e.g. too busy to answer /health in time, or still
            # shutting down after SIGTERM): it is writing to this file — leave it alone.
            return
        name = DAEMON_LOG_FILE.name
        # daemon.log.(N-1) → .N, …, daemon.log → .1 (the oldest is overwritten)
        for i in range(DAEMON_LOG_KEEP, 0, -1):
            src = DAEMON_LOG_FILE if i == 1 else DAEMON_LOG_FILE.with_name(f"{name}.{i - 1}")
            if src.exists():
                src.replace(DAEMON_LOG_FILE.with_name(f"{name}.{i}"))
    except OSError:
        pass  # logging must never stop the daemon from starting


def _start_daemon():
    """Start the pharos web server as a background daemon."""
    if not JAR.exists():
        die(f"pharos JAR not found at {JAR}\n"
            f"Run: mvn clean package -DskipTests")

    PHAROS_DIR.mkdir(parents=True, exist_ok=True)
    _rotate_daemon_log()
    log_fh = open(DAEMON_LOG_FILE, "a")
    proc = subprocess.Popen(
        ["java"] + _jvm_flags() + [
            "-jar", str(JAR),
            "web", "--port", str(DAEMON_PORT), "--no-open"],
        stdout=log_fh,
        stderr=log_fh,
        stdin=subprocess.DEVNULL,
        start_new_session=True,
    )
    DAEMON_PID_FILE.write_text(str(proc.pid))

    # Wait up to 30s for the server to become ready (a reader may still be warming after that:
    # its requests are answered, with a warning, so go ahead once it responds at all)
    deadline = time.monotonic() + 30
    status = None
    while time.monotonic() < deadline:
        status = _health_status()
        if status == 200:
            return
        time.sleep(0.3)
    if status == 503:
        print("pharos daemon is still warming up (first sync or model load); continuing.",
              file=sys.stderr, flush=True)
        return

    die(f"pharos daemon failed to start within 30s.\n"
        f"Check logs: {DAEMON_LOG_FILE}")


def ensure_daemon():
    """Ensure the daemon is running, starting it if necessary."""
    if _is_daemon_running():
        return
    print("Starting pharos daemon...", file=sys.stderr, flush=True)
    _start_daemon()


def _print_header_warnings(value):
    """Print skipped-project notices the daemon sends in X-Pharos-Warnings (a JSON array)."""
    if not value:
        return
    try:
        warnings = json.loads(value)
    except ValueError:
        return
    for w in warnings:
        print(f"\u26a0 {w}", file=sys.stderr)


# Exit codes of a 409 from the daemon (see _api_get)
EXIT_INDEX_INCOMPATIBLE = 4   # a project's index format is not served by this pharos
EXIT_NO_SEARCH_VECTORS = 6    # a search scoped to one project that has no vectors of the search model


def _api_get(path: str, params: dict = None) -> object:
    """Make a GET request to the daemon API. Returns parsed JSON."""
    url = f"{BASE_URL}{path}"
    if params:
        filtered = {k: v for k, v in params.items() if v is not None}
        if filtered:
            url += "?" + urllib.parse.urlencode(filtered)
    try:
        with urllib.request.urlopen(url, timeout=60) as resp:
            # skipped incompatible projects, or a reader answering before its first sync finished
            _print_header_warnings(resp.headers.get("X-Pharos-Warnings"))
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        _print_header_warnings(e.headers.get("X-Pharos-Warnings"))
        if e.code == 409:
            # Two conflicts between the request and the index, told apart by the body:
            #   {"error", "project", "status"}  index format incompatible with this pharos → exit 4
            #   {"error"} only                  a search scoped to one project without vectors
            #                                   of the search model → exit 6
            try:
                parsed = json.loads(body)
            except ValueError:
                parsed = None
            msg = parsed.get("error", body) if isinstance(parsed, dict) else body
            print(msg, file=sys.stderr)
            incompatible = isinstance(parsed, dict) and "status" in parsed
            sys.exit(EXIT_INDEX_INCOMPATIBLE if incompatible else EXIT_NO_SEARCH_VECTORS)
        die(f"API error {e.code}: {body}")
    except urllib.error.URLError as e:
        die(f"Cannot reach pharos daemon: {e.reason}\n"
            f"Try restarting with: pharos daemon restart")


def die(msg: str):
    print(f"pharos: {msg}", file=sys.stderr)
    sys.exit(1)


# ── Output formatters ─────────────────────────────────────────────────────────

def fmt_search(results: list) -> str:
    if not results:
        return "No results found."
    lines = []
    for r in results:
        doc_type = r.get("docType", "method")
        label = r.get("label", r.get("id", "?"))
        project = r.get("project", "")
        sig = r.get("signature", "")
        javadoc = r.get("javadoc", "")
        fp = r.get("filePath", "")
        start = r.get("startLine", "")
        end = r.get("endLine", "")
        score = r.get("score", 0)

        snippet         = r.get("snippet")
        snippet_start   = r.get("snippetStartLine", start)
        snippet_end     = r.get("snippetEndLine",   end)
        lines.append(f"[{doc_type}] **{label}** [{project}]  score={score:.3f}")
        if sig:
            lines.append(f"  {sig}")
        if javadoc:
            first_line = javadoc.strip().split("\n")[0][:120]
            lines.append(f"  {first_line}")
        if fp:
            # Show snippet line range when available (more precise than full method range)
            loc = f"{fp}:{snippet_start}-{snippet_end}" if snippet_start else fp
            lines.append(f"  {loc}")
        if snippet:
            for sl in snippet.split("\n")[:8]:  # cap at 8 lines for terminal display
                lines.append(f"  {sl}")
        lines.append("")
    return "\n".join(lines).rstrip()


def fmt_method(r: dict) -> str:
    if not r:
        return "Method not found."
    label = r.get("label", r.get("id", "?"))
    project = r.get("project", "")
    body = r.get("body", "")
    fp = r.get("filePath", "")
    start = r.get("startLine", "")
    end = r.get("endLine", "")
    javadoc = r.get("javadoc", "")

    lines = [f"**{label}** [{project}]"]
    if javadoc:
        lines.append(f"\n{javadoc.strip()}")
    lines.append(f"\n```java\n{body}\n```")
    if fp:
        lines.append(f"\n`{fp}:{start}-{end}`")
    return "\n".join(lines)


def fmt_class(r: dict) -> str:
    if not r:
        return "Class not found."
    label = r.get("label", r.get("qualifiedClassName", "?"))
    project = r.get("project", "")
    body = r.get("body", "")
    fp = r.get("filePath", "")
    start = r.get("startLine", "")
    end = r.get("endLine", "")
    source_available = r.get("sourceAvailable", True)

    lines = [f"**{label}** [{project}]"]
    if not source_available:
        lines.append("\n*(source file unavailable — showing indexed synthesis)*")
    lines.append(f"\n```java\n{body}\n```")
    if fp:
        lines.append(f"\n`{fp}:{start}-{end}`")
    return "\n".join(lines)


def fmt_class_context(ctx: dict) -> str:
    if not ctx:
        return "Class not found."
    label   = ctx.get("label", ctx.get("fqn", "?"))
    project = ctx.get("project", "")
    fp      = ctx.get("filePath", "")
    start   = ctx.get("startLine", "")
    end     = ctx.get("endLine", "")
    javadoc = ctx.get("javadoc") or ""

    lines = [f"**{label}** [{project}]"]
    if fp:
        lines.append(f"`{fp}:{start}-{end}`")
    if javadoc:
        lines.append(f"/** {javadoc.strip().splitlines()[0][:120]} */")
    lines.append("")

    fields = ctx.get("fields", [])
    if fields:
        lines.append(f"Fields ({len(fields)}):")
        for f in fields:
            ftype = f.get("type") or "?"
            lines.append(f"  [{f.get('accessMod', '')}] {f.get('name', '?')}: {ftype}")
        lines.append("")

    ctors = ctx.get("constructors", [])
    if ctors:
        lines.append(f"Constructors ({len(ctors)}):")
        for c in ctors:
            lines.append(f"  {c.get('signature', c.get('fqn', '?'))}")
        lines.append("")

    methods = ctx.get("publicMethods", [])
    if methods:
        lines.append(f"Public methods ({len(methods)}):")
        for m in methods:
            sig = m.get("signature", m.get("fqn", "?"))
            callers = m.get("callers", [])
            lines.append(f"  {sig}")
            for c in callers[:5]:
                lines.append(f"    ← {c}")
            if len(callers) > 5:
                lines.append(f"    ← ... and {len(callers) - 5} more")
        lines.append("")

    body = ctx.get("body", "")
    if body:
        lines.append("```java")
        lines.append(body)
        lines.append("```")

    return "\n".join(lines)


def _truncate(items: list, limit: int) -> tuple:
    """Return (visible_items, truncated_count). limit=0 means no cap."""
    if limit > 0 and len(items) > limit:
        return items[:limit], len(items) - limit
    return items, 0


def fmt_refs(results: list, label: str, limit: int = 0) -> str:
    if not results:
        return f"No {label} found."
    visible, hidden = _truncate(results, limit)
    lines = []
    for r in visible:
        rid = r.get("id", r.get("label", "?"))
        project = r.get("project", "")
        fp = r.get("filePath", "")
        start = r.get("startLine", "")
        loc = f" at {fp}:{start}" if fp else ""
        lines.append(f"- `{rid}` [{project}]{loc}")
    if hidden:
        lines.append(f"- *... and {hidden} more (use --limit to see more)*")
    return "\n".join(lines)


def fmt_path(data: dict) -> str:
    path = data.get("path", [])
    hops = data.get("hops", 0)
    if not path:
        return "No call path found."
    lines = [f"Call path ({hops} hop{'s' if hops != 1 else ''}):"]
    for i, node in enumerate(path):
        prefix = "START" if i == 0 else ("END" if i == len(path) - 1 else "→")
        lines.append(f"  {prefix} `{node}`")
    return "\n".join(lines)


def fmt_pipelines(pipelines: list) -> str:
    if not pipelines:
        return "No pipelines available."
    lines = ["Available search pipelines:\n"]
    for p in pipelines:
        avail = "" if p.get("available", True) else "  [unavailable — required component not loaded]"
        lines.append(f"  {p['id']:<26} {p['label']}{avail}")
        desc = p.get("description", "")
        if desc:
            lines.append(f"  {'':26} {desc}")
        lines.append("")
    lines.append("Use with:  pharos search \"query\" --pipeline <id>")
    return "\n".join(lines).rstrip()


def fmt_projects(projects: list, limit: int = 0) -> str:
    if not projects:
        return "No projects indexed yet. Run `pharos index <path>` first."
    visible, hidden = _truncate(projects, limit)
    lines = ["Indexed projects:"]
    for p in visible:
        name = p.get("name", "?")
        methods = p.get("methodCount", 0)
        classes = p.get("classCount", 0)
        last = p.get("lastIndexed", "")
        fmt_status = (p.get("indexFormat") or {}).get("status", "ok")
        flag = {"ok": "",
                "upgrade-available": " [upgrade available (still searchable): pharos index --full]",
                "outdated": " [needs upgrade: pharos index --full]",
                "newer": " [index from a newer pharos]"}.get(fmt_status, "")
        lines.append(f"- **{name}**: {methods} methods, {classes} classes (last indexed: {last}){flag}")
    if hidden:
        lines.append(f"- *... and {hidden} more*")
    return "\n".join(lines)


def fmt_modules(data: dict, limit: int = 0) -> str:
    modules = data.get("modules", [])
    total = data.get("total", 0)
    edges = data.get("edges", 0)
    indexed = sum(1 for m in modules if m.get("indexed"))
    external = total - indexed
    visible, hidden = _truncate(modules, limit)
    lines = [f"Module graph: **{total}** nodes ({indexed} indexed, {external} external), **{edges}** edges\n"]
    for m in visible:
        key = m.get("moduleKey", "?")
        status = f"✓ indexed [{m.get('projectName')}]" if m.get("indexed") else "⊘ external"
        deps = m.get("depCount", 0)
        used = m.get("usedByCount", 0)
        ver = m.get("version", "")
        lines.append(f"- `{key}` {status} — deps: {deps}, used-by: {used}, version: {ver}")
    if hidden:
        lines.append(f"- *... and {hidden} more (use --limit to see more)*")
    return "\n".join(lines)


def fmt_deps(data: dict, limit: int = 0) -> str:
    key = data.get("moduleKey", "?")
    indexed = data.get("indexed", False)
    project = data.get("projectName", "")
    version = data.get("version", "")
    transitive = data.get("transitive", False)
    deps = data.get("dependencies", [])
    dependents = data.get("dependents", [])
    status = f"indexed/{project}" if indexed else "external"
    t_label = "transitive, " if transitive else ""

    lines = [f"**{key}** [{status}] version: {version}\n"]
    vis_deps, hid_deps = _truncate(deps, limit)
    lines.append(f"**Dependencies ({t_label}{len(deps)}):**")
    for d in vis_deps:
        lines.append(f"- → `{d['moduleKey']}` [{'indexed' if d.get('indexed') else 'external'}]")
    if hid_deps:
        lines.append(f"- *... and {hid_deps} more*")
    vis_dep, hid_dep = _truncate(dependents, limit)
    lines.append(f"\n**Used by ({t_label}{len(dependents)}):**")
    for d in vis_dep:
        lines.append(f"- ← `{d['moduleKey']}` [{'indexed' if d.get('indexed') else 'external'}]")
    if hid_dep:
        lines.append(f"- *... and {hid_dep} more*")
    return "\n".join(lines)


def fmt_mod_path(data: dict) -> str:
    path = data.get("path", [])
    hops = data.get("hops", 0)
    if not path:
        return "No dependency path found."
    lines = [f"Dependency path ({hops} hop{'s' if hops != 1 else ''}):"]
    for i, n in enumerate(path):
        marker = "**START**" if i == 0 else ("**END**" if i == len(path) - 1 else "→")
        status = f"indexed/{n.get('projectName')}" if n.get("indexed") else "external"
        lines.append(f"  {marker} `{n['moduleKey']}` [{status}]")
    return "\n".join(lines)


def fmt_skeleton(classes: list, limit: int = 0) -> str:
    """Render skeleton as a filesystem tree grouped by source path."""
    if not classes:
        return "No public/protected classes found."

    # Deduplicate: same qualifiedClassName can appear twice from multi-segment indexes.
    seen_classes: dict[str, dict] = {}
    for cls in classes:
        key = cls.get("qualifiedClassName") or cls.get("className", "?")
        if key not in seen_classes:
            seen_classes[key] = cls
        else:
            # Merge method lists (deduplicate by signature text)
            existing = seen_classes[key]
            existing_sigs = set(existing.get("methods", []))
            for m in cls.get("methods", []):
                if m not in existing_sigs:
                    existing.setdefault("methods", []).append(m)
                    existing_sigs.add(m)
    deduped = list(seen_classes.values())

    visible, hidden = _truncate(deduped, limit)

    # Build tree: map path segments → list of (file_leaf, methods, display_name)
    # We derive a short path from filePath (strip up to src/main/java, src/main/python, etc.)
    # or fall back to the package path from qualifiedClassName.
    def short_path(cls: dict) -> list[str]:
        fp = cls.get("filePath", "")
        if fp:
            fp = fp.replace("\\", "/")
            # Strip everything up to a known source root marker
            for marker in ("/src/main/java/", "/src/main/python/", "/src/main/",
                           "/main/java/", "/main/", "/src/"):
                idx = fp.find(marker)
                if idx >= 0:
                    fp = fp[idx + len(marker):]
                    break
            else:
                # Just use the last N components
                parts = fp.split("/")
                fp = "/".join(parts[-4:]) if len(parts) >= 4 else fp
            return fp.split("/")
        # Fallback: derive from qualified class name
        qname = cls.get("qualifiedClassName", "?")
        parts = qname.replace(".", "/").split("/")
        # Last part is the class — append .java
        parts[-1] = parts[-1].split("$")[0] + ".java"
        return parts

    # Build a nested dict tree: {segment: subtree | None}
    # Leaves: segment is a filename, value is list of method sigs
    tree: dict = {}
    for cls in visible:
        parts = short_path(cls)
        node = tree
        for part in parts[:-1]:
            node = node.setdefault(part, {})
        leaf = parts[-1]
        # Store methods under a special key; merge if leaf already seen
        existing = node.get(leaf)
        methods = cls.get("methods", [])
        if existing is None:
            node[leaf] = {"__methods__": list(methods)}
        elif isinstance(existing, dict):
            seen_m = set(existing.get("__methods__", []))
            for m in methods:
                if m not in seen_m:
                    existing["__methods__"].append(m)
                    seen_m.add(m)

    def render_tree(node: dict, prefix: str = "") -> list[str]:
        out = []
        keys = sorted(node.keys())
        for i, key in enumerate(keys):
            is_last = (i == len(keys) - 1)
            connector = "└── " if is_last else "├── "
            child_prefix = prefix + ("    " if is_last else "│   ")
            val = node[key]
            if isinstance(val, dict):
                methods = val.pop("__methods__", [])
                if val:
                    # Directory with children
                    out.append(f"{prefix}{connector}{key}/")
                    out.extend(render_tree(val, child_prefix))
                else:
                    # File leaf
                    out.append(f"{prefix}{connector}{key}")
                    for j, m in enumerate(methods):
                        # Strip annotation prefixes for readability
                        sig = m.strip()
                        for ann in ("@Override ", "@Override\n"):
                            sig = sig.replace(ann, "")
                        # Collapse long generics
                        m_last = "└── " if j == len(methods) - 1 else "├── "
                        out.append(f"{child_prefix}{m_last}{sig}")
        return out

    lines = render_tree(tree)
    if hidden:
        lines.append(f"\n... and {hidden} more classes (use --limit N to see more)")
    return "\n".join(lines)


def fmt_boundary(data: dict, limit: int = 0) -> str:
    project = data.get("project", "?")
    entry = data.get("entryPoints", [])
    exits = data.get("exitPoints", [])
    total_exits = data.get("totalExitPoints", len(exits))
    lines = [f"**Module boundary for `{project}`**\n"]
    vis_entry, hid_entry = _truncate(entry, limit)
    lines.append(f"**Entry points** (methods called by other linked modules): {len(entry)}")
    if not entry:
        lines.append("- *(none — no linked projects have been indexed yet)*")
    else:
        for fqn in vis_entry:
            lines.append(f"- `{fqn}`")
        if hid_entry:
            lines.append(f"- *... and {hid_entry} more*")
    shown = len(exits)
    exit_label = f"{total_exits}" if total_exits == shown else f"{shown} of {total_exits}"
    lines.append(f"\n**Exit points** (unresolved external calls): {exit_label}")
    if not exits:
        lines.append("- *(none recorded)*")
    else:
        vis_exits, hid_exits = _truncate(exits, limit)
        for ep in vis_exits:
            lines.append(f"- `{ep['callerFqn']}` → `{ep['calleeSimpleName']}` (line {ep['line']})")
        if hid_exits:
            lines.append(f"- *... and {hid_exits} more (use --limit to see more)*")
    return "\n".join(lines)


