def _gib(n):
    """Bytes as B / KiB / MiB / GiB / TiB with one decimal (same as the jar's reader cache line)."""
    v = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if v < 1024 or unit == "TiB":
            return f"{int(n)} B" if unit == "B" else f"{v:.1f} {unit}"
        v /= 1024


def reader_cache_line(rc):
    """One-line text form of the `readerCache` object of index-status --json and /health."""
    if rc.get("mode") == "full":
        return "reader cache: full mode (no block cache)"
    rate = f"{100 * rc['hitRate']:.1f}%" if rc["hits"] + rc["misses"] > 0 else "n/a"
    return (f"reader cache: {_gib(rc['bytesOnDisk'])} / {_gib(rc['cacheMaxBytes'])}, "
            f"hit rate {rate}, {rc['evictions']} evictions")


def _daemon_reader_cache():
    """The running daemon's `readerCache` (its hits are the real ones), or None. A warming
    reader answers 503 with the same body."""
    try:
        with urllib.request.urlopen(f"{BASE_URL}/health", timeout=1) as resp:
            return json.loads(resp.read()).get("readerCache")
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read()).get("readerCache")
        except Exception:
            return None
    except Exception:
        return None


def index_status_json(text):
    """index-status --json from the jar, its `readerCache` replaced by the running daemon's (its
    hits are the real ones; the one-shot JVM served no queries) with "source": "daemon"."""
    try:
        doc = json.loads(text)
    except ValueError:
        return text
    daemon = _daemon_reader_cache() if "readerCache" in doc else None
    if daemon:
        doc["readerCache"] = dict(daemon, source="daemon")
    return json.dumps(doc, indent=2)


def cmd_index_status(args):
    """Show per-project index format status (read-only; spawns the jar, no daemon).

    On a lazy reader the text output ends with a `reader cache:` line; when a daemon is
    running its figures replace the one-shot JVM's (which has served no queries).
    """
    if not JAR.exists():
        die(f"pharos JAR not found at {JAR}\nRun: mvn clean package -DskipTests")
    cmd = ["java"] + _jvm_flags() + ["-jar", str(JAR), "index-status"]
