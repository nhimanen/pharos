    )
    p_daemon.add_argument(
        "action",
        choices=["start", "stop", "restart", "status", "logs"],
        help="Action to perform",
    )
    p_daemon.set_defaults(func=cmd_daemon)

    return parser


# ── Entry point ───────────────────────────────────────────────────────────────

def main():
    if len(sys.argv) == 1:
        print(OVERVIEW)
        sys.exit(0)

    parser = build_parser()
    args = parser.parse_args()

    if args.version:
        cmd_version(args)

    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()
