        cmd.append("--json")
    r = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)
    if args.json:
        print(index_status_json(r.stdout))
        sys.exit(r.returncode)
    lines = r.stdout.splitlines()
    own = [l for l in lines if l.startswith("reader cache:")]
    if own:
        daemon = _daemon_reader_cache()
        replacement = reader_cache_line(daemon) if daemon else own[0]
        lines = [replacement if l.startswith("reader cache:") else l for l in lines]
    if lines:
        print("\n".join(lines))
    sys.exit(r.returncode)


