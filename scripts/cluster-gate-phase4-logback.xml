<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for scripts/cluster-gate-phase4.sh: the Phase 1-3 gate config (console WARN+, com.pharos.cluster
     at INFO) plus the indexer's INFO lines. The Phase 4 driver counts embedding provider calls on a takeover
     from ProjectIndexManager's "Embedding cache[model]: H hit(s), M miss(es) for 'shard'" line. -->
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
    </appender>
    <appender name="INFO" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
    <logger name="com.pharos.cluster" level="INFO" additivity="false">
        <appender-ref ref="INFO"/>
    </logger>
    <logger name="com.pharos.indexer.ProjectIndexManager" level="INFO" additivity="false">
        <appender-ref ref="INFO"/>
    </logger>
    <logger name="com.github.javaparser" level="ERROR"/>
    <logger name="org.jgrapht" level="WARN"/>
    <logger name="ai.djl" level="WARN"/>
</configuration>
